# TokenPool 环境配置模板：cp .env.example .env 后填写
# 前端常量注入：填写后执行 bash scripts/apply-config.sh 生成 public/index.html

# Supabase 项目 URL（Dashboard → Project Settings → API）
SUPABASE_URL=

# Supabase service_role key（仅后端使用，绝不可暴露到前端/仓库）
SUPABASE_SERVICE_KEY=

# Supabase publishable key（sb_publishable_ 开头，注入前端 index.html）
SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile：secret（后端校验）与 sitekey（前端 widget）
TURNSTILE_SECRET=
TURNSTILE_SITEKEY=

# 对外访问地址（如 https://your-domain.example，用于告警/跳转链接）
PUBLIC_URL=

# Bark 推送 key（可选，healthcheck-alert.mjs 告警用）
BARK_KEY=
